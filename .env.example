# ========================
# Environment
# ========================
NODE_ENV=development
PORT=3000

# ========================
# Database (PostgreSQL)
# ========================
# Local development on host machine: use "localhost"
# Docker containers use `.env.docker` with hostname "db"
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=staffup_lms
DATABASE_URL="postgresql://admin:password123@localhost:5432/staffup_lms?schema=public"

# ========================
# JWT Configuration
# ========================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=staffup_refresh_token

# ========================
# CORS
# ========================
CORS_ORIGIN=http://localhost:5173

# ========================
# Seed Admin User
# ========================
SEED_ADMIN_DEPARTMENT_NAME=General
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_POSITION_TITLE=Administrator
SEED_ADMIN_EMAIL=admin@staffup.local
SEED_ADMIN_PASSWORD=ChangeMe123
