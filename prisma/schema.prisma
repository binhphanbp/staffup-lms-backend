  provider             String   @default("gemini") @db.VarChar(50)
  chatModel            String   @default("gemini-2.5-flash") @map("chat_model") @db.VarChar(100)
  embeddingModel       String   @default("gemini-embedding-001") @map("embedding_model") @db.VarChar(100)
  prompts              Json     @default("{}")
  modules              Json     @default("{}")
  topKResults          Int      @default(5) @map("top_k_results")
  maxMessagesPerMinute Int      @default(10) @map("max_messages_per_minute")
  temperature          Float    @default(0.4)
  updatedBy            BigInt?  @map("updated_by")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ai_config")
}

model UserGamification {
  userId           BigInt    @id @map("user_id")
  totalXp          Int       @default(0) @map("total_xp")
  currentLevel     Int       @default(1) @map("current_level")
  currentStreak    Int       @default(0) @map("current_streak")
  longestStreak    Int       @default(0) @map("longest_streak")
  lastActivityDate DateTime? @map("last_activity_date") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalXp])
  @@map("user_gamification")
}

model XpTransaction {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt   @map("user_id")
  amount      Int
  source      String   @db.VarChar(50)
  referenceId String?  @map("reference_id") @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("xp_transactions")
}

model Badge {
  id          BigInt      @id @default(autoincrement())
  code        String      @unique @db.VarChar(80)
  name        String      @db.VarChar(150)
  description String      @db.VarChar(500)
  iconName    String      @default("emoji_events") @map("icon_name") @db.VarChar(80)
  tier        String      @default("bronze") @db.VarChar(20)
  criteria    Json        @default("{}")
  sortOrder   Int         @default(0) @map("sort_order")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
