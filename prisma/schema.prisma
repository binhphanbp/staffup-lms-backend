model RoleplayScenario {
  id               BigInt            @id @default(autoincrement())
  slug             String            @unique @db.VarChar(120)
  title            String            @db.VarChar(200)
  description      String            @db.VarChar(2000)
  personaName      String            @map("persona_name") @db.VarChar(100)
  personaRole      String            @map("persona_role") @db.VarChar(150)
  personaTone      String            @default("neutral") @map("persona_tone") @db.VarChar(50)
  context          String
  openingLine      String            @map("opening_line")
  objectives       Json              @default("[]")
  evaluationRubric Json              @default("[]") @map("evaluation_rubric")
  difficulty       String            @default("medium") @db.VarChar(20)
  category         String            @default("communication") @db.VarChar(50)
  estimatedMinutes Int               @default(8) @map("estimated_minutes")
  maxTurns         Int               @default(12) @map("max_turns")
  language         String            @default("vi") @db.VarChar(10)
  voiceHint        String?           @map("voice_hint") @db.VarChar(50)
  isActive         Boolean           @default(true) @map("is_active")
  createdById      BigInt?           @map("created_by_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions         RoleplaySession[]

  @@index([isActive])
  @@index([category])
  @@map("roleplay_scenarios")
}

model RoleplaySession {
  id         BigInt              @id @default(autoincrement())
  scenarioId BigInt              @map("scenario_id")
  userId     BigInt              @map("user_id")
  status     String              @default("in_progress") @db.VarChar(20)
  startedAt  DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  endedAt    DateTime?           @map("ended_at") @db.Timestamptz(6)
  scenario   RoleplayScenario    @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns      RoleplayTurn[]
  evaluation RoleplayEvaluation?

  @@index([userId, startedAt])
  @@index([scenarioId])
  @@map("roleplay_sessions")
}

model RoleplayTurn {
  id         BigInt          @id @default(autoincrement())
  sessionId  BigInt          @map("session_id")
  role       String          @db.VarChar(20)
  content    String
  orderIndex Int             @map("order_index")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  session    RoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, orderIndex])
  @@map("roleplay_turns")
}

model RoleplayEvaluation {
  id              BigInt          @id @default(autoincrement())
  sessionId       BigInt          @unique @map("session_id")
  overallScore    Int             @map("overall_score")
  band            String          @db.VarChar(20)
  criterionScores Json            @default("[]") @map("criterion_scores")
  strengths       Json            @default("[]")
  improvements    Json            @default("[]")
  summary         String
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  session         RoleplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("roleplay_evaluations")
}

enum risk_level {
  low
  medium
  high
}

model OnboardingTemplate {
  id             BigInt            @id @default(autoincrement())
  slug           String            @unique @db.VarChar(120)
  name           String            @db.VarChar(200)
  description    String            @default("") @db.VarChar(1000)
  targetPosition String?           @map("target_position") @db.VarChar(150)
  departmentId   BigInt?           @map("department_id")
  totalDays      Int               @default(90) @map("total_days")
  isActive       Boolean           @default(true) @map("is_active")
  isSystem       Boolean           @default(false) @map("is_system")
  createdById    BigInt?           @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy      User?             @relation("OnboardingTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  stages         OnboardingStage[]
  plans          OnboardingPlan[]

  @@index([isActive])
  @@index([departmentId])
  @@map("onboarding_templates")
}

model OnboardingPlan {
  id           BigInt              @id @default(autoincrement())
  templateId   BigInt?             @map("template_id")
  templateName String              @map("template_name") @db.VarChar(200)
  assigneeId   BigInt              @map("assignee_id")
  managerId    BigInt              @map("manager_id")
  startDate    DateTime            @map("start_date") @db.Date
  status       String              @default("active") @db.VarChar(20)
  notes        String?             @db.VarChar(1000)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  template     OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignee     User                @relation("OnboardingPlanAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  manager      User                @relation("OnboardingPlanManager", fields: [managerId], references: [id], onDelete: Cascade)
  stages       OnboardingStage[]

  @@index([assigneeId, status])
  @@index([managerId])
  @@map("onboarding_plans")
}

model OnboardingStage {
  id              BigInt              @id @default(autoincrement())
  templateId      BigInt?             @map("template_id")
  planId          BigInt?             @map("plan_id")
  name            String              @db.VarChar(120)
  description     String?             @db.VarChar(500)
  orderIndex      Int                 @map("order_index")
  startOffsetDays Int                 @default(0) @map("start_offset_days")
  endOffsetDays   Int                 @default(30) @map("end_offset_days")
  template        OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  plan            OnboardingPlan?     @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks           OnboardingTask[]

  @@index([templateId, orderIndex])
  @@index([planId, orderIndex])
  @@map("onboarding_stages")
}

model OnboardingTask {
  id             BigInt          @id @default(autoincrement())
  stageId        BigInt          @map("stage_id")
  title          String          @db.VarChar(250)
  description    String?         @db.VarChar(1000)
  category       String          @default("learning") @db.VarChar(30)
  priority       String          @default("medium") @db.VarChar(20)
  estimatedHours Int             @default(2) @map("estimated_hours")
  orderIndex     Int             @map("order_index")
  courseId       BigInt?         @map("course_id")
  resourceUrl    String?         @map("resource_url") @db.VarChar(500)
  status         String          @default("pending") @db.VarChar(20)
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz(6)
  completedById  BigInt?         @map("completed_by_id")
  managerNote    String?         @map("manager_note") @db.VarChar(500)
  stage          OnboardingStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  course         Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  completedBy    User?           @relation("OnboardingTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([stageId, orderIndex])
  @@map("onboarding_tasks")
}
