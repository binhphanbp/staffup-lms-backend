# ========================
# Environment
# ========================
NODE_ENV=development
PORT=3000

# ========================
# Database (PostgreSQL)
# ========================
# Docker internal network: use "db" as hostname
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=staffup_lms
DATABASE_URL="postgresql://admin:password123@db:5432/staffup_lms?schema=public"

# ========================
# JWT Configuration
# ========================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=staffup_refresh_token

# ========================
# CORS
# ========================
CORS_ORIGIN=http://localhost:5173

GEMINI_API_KEY=your_actual_key_here